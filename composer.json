{
    "name": "tyhpdef/nette-schema-impl",
    "description": "Implementation package for tyhpdef/nette-schema. Require tyhpdef/nette-schema, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.3.6.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/nette-utils": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/nette-schema"
        }
    },
    "require": {
        "php": ">=8.2",
        "nette/schema": "1.3.6"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/nette-utils": "@dev"
    }
}
